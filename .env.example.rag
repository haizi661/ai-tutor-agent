# ============================================================================
# RAG 2.0 系统配置示例
# ============================================================================
# 复制此文件内容到 .env 并填入实际的 API Key
# ============================================================================

# 【1】Embedding 配置 - 千问/阿里巴巴
# ============================================================================
# 选项：local | google | openai | dashscope
EMBEDDING_PROVIDER=dashscope

# 千问 API Key (阿里云百炼)
# 从 https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=your-dashscope-api-key-here

# Embedding 模型名称 (默认留空，系统自动选择)
# 可选：text-embedding-v2 (千问推荐)
EMBEDDING_MODEL_NAME=

# 【2】MinerU PDF 解析配置
# ============================================================================
# MinerU API Token (用于远程 PDF 解析)
# 从 https://mineru.net/ 获取
MINERU_API_TOKEN=your-mineru-api-token-here

# 【3】向量存储配置
# ============================================================================
# ChromaDB 本地数据库位置
CHROMA_DIR=data/chroma_db

# 知识库文件目录 (存放 PDF 等知识文件)
KNOWLEDGE_DIR=data/knowledge

# 向量存储后端：chroma | inmemory
VECTOR_STORE_BACKEND=chroma

# 【4】内存和会话配置
# ============================================================================
# 对话历史数据库路径
MEMORY_DB_PATH=data/tutor_memory.db

# 主要 LLM 提供商：openai | google | qwen | deepseek
# （用于知识库查询改写）
LLM_PROVIDER=openai

# OpenAI API 配置（可选）
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
MODEL_NAME=gpt-4-mini

# DeepSeek API 配置（可选，debug_rag 优先使用）
DEEPSEEK_API_KEY=your-deepseek-api-key

# 【5】知识库检索参数
# ============================================================================
# 单次检索返回的文档数量
KNOWLEDGE_TOP_K=3

# 文本分块大小
KNOWLEDGE_CHUNK_SIZE=1000

# 分块重叠
KNOWLEDGE_CHUNK_OVERLAP=150

# ============================================================================
# 使用说明
# ============================================================================
# 1. 复制本文件: cp .env.example.rag .env
# 2. 编辑 .env 文件，填入你的 API Key
# 3. 启动应用：python main.py
# 4. 调试 RAG：python debug_rag.py
