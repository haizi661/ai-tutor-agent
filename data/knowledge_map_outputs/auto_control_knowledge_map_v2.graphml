      <data key="d28">{"chapter_anchor_node_id": "KM012", "chapter_anchor_name": "线性系统的时域分析法", "is_focus_chapter": true, "chapter_page_range": [82, 159], "retrieval_keywords": ["时域分析", "时间响应", "系统响应"], "syllabus_rule_source": "chapter_inherited", "configured_prerequisites": ["线性系统的稳定性分析"], "node_role": "topic", "order_in_chapter": 6, "legacy_level": 2, "legacy_part_of": "KM012", "resolved_prerequisite_nodes": ["KM017"], "resolved_related_nodes": ["KM012", "KM017", "KM019"], "resolved_weak_related_nodes": [], "resolved_dependent_nodes": ["KM019"], "resolved_prerequisite_names": ["线性系统的稳定性分析"], "resolved_related_names": ["线性系统的时域分析法", "线性系统的稳定性分析", "控制系统时域设计"], "resolved_weak_related_names": [], "resolved_dependent_names": ["控制系统时域设计"], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM019", "reason": "这是当前知识点在本章内部的后续学习内容"}], "mineru_doc_name": "chapter_03_p082-159_线性系统的时域分析法.pdf", "anchor_page": 154, "page_refs_refined": [153, 154, 155, 156, 157], "page_ref_status": "ok", "page_ref_count": 78, "page_refined_count": 5, "matched_block_title": "3-6 线性系统的稳态误差计算", "matched_block_score": 65, "content_evidence_block_count": 6, "content_evidence_block_titles": ["5. 劳斯稳定判据的应用", "3-6 线性系统的稳态误差计算", "1. 误差与稳态误差", "3. 阶跃输入作用下的稳态误差与静态位置误差系数", "4. 斜坡输入作用下的稳态误差与静态速度误差系数", "5. 加速度输入作用下的稳态误差与静态加速度误差系数"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 16, "retrieval_formula_line_count": 38, "retrieval_figure_line_count": 7, "retrieval_source_pdf": "chapter_03_p082-159_线性系统的时域分析法.pdf", "retrieval_matched_block_title": "3-6 线性系统的稳态误差计算", "retrieval_matched_block_score": 65, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["5. 劳斯稳定判据的应用", "3-6 线性系统的稳态误差计算", "1. 误差与稳态误差", "3. 阶跃输入作用下的稳态误差与静态位置误差系数", "4. 斜坡输入作用下的稳态误差与静态速度误差系数", "5. 加速度输入作用下的稳态误差与静态加速度误差系数"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
