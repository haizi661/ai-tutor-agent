      <data key="d28">{"chapter_anchor_node_id": "KM030", "chapter_anchor_name": "线性系统的校正方法", "is_focus_chapter": true, "chapter_page_range": [263, 311], "retrieval_keywords": ["系统校正", "控制器设计"], "syllabus_rule_source": "chapter_inherited", "configured_prerequisites": ["频率特性"], "node_role": "topic", "order_in_chapter": 1, "legacy_level": 2, "legacy_part_of": "KM030", "resolved_prerequisite_nodes": ["KM027"], "resolved_related_nodes": ["KM030", "KM032"], "resolved_weak_related_nodes": [], "resolved_dependent_nodes": ["KM032"], "resolved_prerequisite_names": ["频率特性"], "resolved_related_names": ["线性系统的校正方法", "串联校正"], "resolved_weak_related_names": [], "resolved_dependent_names": ["串联校正"], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM032", "reason": "这是当前知识点在本章内部的后续学习内容"}], "mineru_doc_name": "chapter_06_p263-311_线性系统的校正方法.pdf", "anchor_page": 294, "page_refs_refined": [293, 294, 295, 296, 297], "page_ref_status": "ok", "page_ref_count": 49, "page_refined_count": 5, "matched_block_title": "6-2 常用校正装置及其特性", "matched_block_score": 46, "content_evidence_block_count": 6, "content_evidence_block_titles": ["3. 校正方式", "图 6-4 复合校正系统结构图", "6-2 常用校正装置及其特性", "(1) 无源超前网络", "2. 有源校正装置", "1. 频率响应法校正设计"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 15, "retrieval_formula_line_count": 14, "retrieval_figure_line_count": 7, "retrieval_source_pdf": "chapter_06_p263-311_线性系统的校正方法.pdf", "retrieval_matched_block_title": "6-2 常用校正装置及其特性", "retrieval_matched_block_score": 46, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["6-1 系统的设计与校正问题", "3. 校正方式", "图 6-4 复合校正系统结构图", "6-2 常用校正装置及其特性", "(1) 无源超前网络", "2. 有源校正装置"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
