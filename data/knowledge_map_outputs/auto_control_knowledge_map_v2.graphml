      <data key="d28">{"is_focus": false, "enabled": true, "subtopic_count_configured": 2, "chapter_page_range": [393, 454], "retrieval_keywords": ["状态空间", "状态变量"], "syllabus_rule_source": "course_graph_config", "configured_prerequisites": [], "node_role": "chapter_anchor", "legacy_level": 1, "legacy_part_of": "", "resolved_prerequisite_nodes": [], "resolved_related_nodes": ["KM039", "KM040"], "resolved_weak_related_nodes": ["KM026"], "resolved_dependent_nodes": ["KM030"], "resolved_prerequisite_names": [], "resolved_related_names": ["状态空间表达式", "可控性与可观性"], "resolved_weak_related_names": ["线性系统的频域分析法"], "resolved_dependent_names": ["线性系统的校正方法"], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM039", "reason": "推荐先学习本章的第一个核心子知识点"}], "mineru_doc_name": "chapter_08_p393-454_线性系统的状态空间分析与综合.pdf", "anchor_page": 393, "page_refs_refined": [393, 394, 395, 396, 397], "page_ref_status": "ok", "page_ref_count": 62, "page_refined_count": 5, "matched_block_title": "(1) 状态反馈控制", "matched_block_score": 9, "content_evidence_block_count": 6, "content_evidence_block_titles": ["8-1 非线性控制系统概述", "1. 相平面的基本概念", "5. 非线性系统的相平面分析", "4. 非线性控制的逆系统设计方法", "(1) 状态反馈控制", "(2) 渐近跟踪控制"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 24, "retrieval_formula_line_count": 42, "retrieval_figure_line_count": 12, "retrieval_source_pdf": "chapter_08_p393-454_线性系统的状态空间分析与综合.pdf", "retrieval_matched_block_title": "(1) 状态反馈控制", "retrieval_matched_block_score": 9, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["8-1 非线性控制系统概述", "1. 研究非线性控制理论的意义", "1. 相平面的基本概念", "5. 非线性系统的相平面分析", "4. 非线性控制的逆系统设计方法", "(1) 状态反馈控制"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
