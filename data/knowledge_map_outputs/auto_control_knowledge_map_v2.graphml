      <data key="d28">{"chapter_anchor_node_id": "KM012", "chapter_anchor_name": "线性系统的时域分析法", "is_focus_chapter": true, "chapter_page_range": [82, 159], "retrieval_keywords": ["时域分析", "时间响应", "系统响应"], "syllabus_rule_source": "chapter_inherited", "configured_prerequisites": ["高阶系统的时域分析"], "node_role": "topic", "order_in_chapter": 5, "legacy_level": 2, "legacy_part_of": "KM012", "resolved_prerequisite_nodes": ["KM016"], "resolved_related_nodes": ["KM012", "KM016", "KM018"], "resolved_weak_related_nodes": [], "resolved_dependent_nodes": ["KM018", "KM029"], "resolved_prerequisite_names": ["高阶系统的时域分析"], "resolved_related_names": ["线性系统的时域分析法", "高阶系统的时域分析", "线性系统的稳态误差计算"], "resolved_weak_related_names": [], "resolved_dependent_names": ["线性系统的稳态误差计算", "频率域稳定判据"], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM018", "reason": "这是当前知识点在本章内部的后续学习内容"}], "mineru_doc_name": "chapter_03_p082-159_线性系统的时域分析法.pdf", "anchor_page": 153, "page_refs_refined": [152, 153, 154, 155, 156], "page_ref_status": "ok", "page_ref_count": 78, "page_refined_count": 5, "matched_block_title": "3-5 线性系统的稳定性分析", "matched_block_score": 63, "content_evidence_block_count": 6, "content_evidence_block_titles": ["第三章 线性系统的时域分析法", "3. 高阶系统闭环主导极点及其动态性能分析", "3-5 线性系统的稳定性分析", "1. 稳定性的基本概念", "3. 劳斯-赫尔维茨稳定判据", "(1) 赫尔维茨稳定判据"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 9, "retrieval_formula_line_count": 18, "retrieval_figure_line_count": 3, "retrieval_source_pdf": "chapter_03_p082-159_线性系统的时域分析法.pdf", "retrieval_matched_block_title": "3-5 线性系统的稳定性分析", "retrieval_matched_block_score": 63, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["第三章 线性系统的时域分析法", "3. 高阶系统闭环主导极点及其动态性能分析", "3-5 线性系统的稳定性分析", "1. 稳定性的基本概念", "3. 劳斯-赫尔维茨稳定判据", "(1) 赫尔维茨稳定判据"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
