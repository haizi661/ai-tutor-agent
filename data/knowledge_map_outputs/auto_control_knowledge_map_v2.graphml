      <data key="d28">{"chapter_anchor_node_id": "KM020", "chapter_anchor_name": "线性系统的根轨迹法", "is_focus_chapter": true, "chapter_page_range": [160, 204], "retrieval_keywords": ["根轨迹", "根轨迹法"], "syllabus_rule_source": "chapter_inherited", "configured_prerequisites": ["系统性能的分析"], "node_role": "topic", "order_in_chapter": 5, "legacy_level": 2, "legacy_part_of": "KM020", "resolved_prerequisite_nodes": ["KM024"], "resolved_related_nodes": ["KM020", "KM024"], "resolved_weak_related_nodes": [], "resolved_dependent_nodes": [], "resolved_prerequisite_names": ["系统性能的分析"], "resolved_related_names": ["线性系统的根轨迹法", "系统性能的分析"], "resolved_weak_related_names": [], "resolved_dependent_names": [], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM026", "reason": "本章子知识点已学习完毕，可进入下一章概览节点"}], "mineru_doc_name": "chapter_04_p160-204_线性系统的根轨迹法.pdf", "anchor_page": 169, "page_refs_refined": [168, 169, 170, 171, 172], "page_ref_status": "ok", "page_ref_count": 45, "page_refined_count": 5, "matched_block_title": "4-1 根轨迹法的基本概念", "matched_block_score": 16, "content_evidence_block_count": 6, "content_evidence_block_titles": ["ROOT", "4-1 根轨迹法的基本概念", "1. 根轨迹概念", "2. 根轨迹与系统性能", "4. 根轨迹方程", "3. 零度根轨迹"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 20, "retrieval_formula_line_count": 20, "retrieval_figure_line_count": 3, "retrieval_source_pdf": "chapter_04_p160-204_线性系统的根轨迹法.pdf", "retrieval_matched_block_title": "4-1 根轨迹法的基本概念", "retrieval_matched_block_score": 16, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["ROOT", "4-1 根轨迹法的基本概念", "1. 根轨迹概念", "2. 根轨迹与系统性能", "4. 根轨迹方程", "4-2 根轨迹绘制的基本法则"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
