      <data key="d28">{"chapter_anchor_node_id": "KM035", "chapter_anchor_name": "线性离散系统的分析与校正", "is_focus_chapter": false, "chapter_page_range": [312, 392], "retrieval_keywords": ["离散系统", "采样系统"], "syllabus_rule_source": "chapter_inherited", "configured_prerequisites": [], "node_role": "topic", "order_in_chapter": 1, "legacy_level": 2, "legacy_part_of": "KM035", "resolved_prerequisite_nodes": [], "resolved_related_nodes": ["KM035", "KM037"], "resolved_weak_related_nodes": [], "resolved_dependent_nodes": [], "resolved_prerequisite_names": [], "resolved_related_names": ["线性离散系统的分析与校正", "Z变换与脉冲传递函数"], "resolved_weak_related_names": [], "resolved_dependent_names": [], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM037", "reason": "这是当前知识点在本章内部的后续学习内容"}], "mineru_doc_name": "chapter_07_p312-392_线性离散系统的分析与校正.pdf", "anchor_page": 328, "page_refs_refined": [327, 328, 329, 330, 331], "page_ref_status": "ok", "page_ref_count": 81, "page_refined_count": 5, "matched_block_title": "7-1 离散系统的基本概念", "matched_block_score": 65, "content_evidence_block_count": 6, "content_evidence_block_titles": ["第七章 线性离散系统的分析与校正", "7-1 离散系统的基本概念", "1. 采样控制系统", "(2) 采样系统的典型结构图", "7-4 离散系统的数学模型", "7-12 设有单位反馈误差采样的离散系统，连续部分传递函数为"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 7, "retrieval_formula_line_count": 6, "retrieval_figure_line_count": 4, "retrieval_source_pdf": "chapter_07_p312-392_线性离散系统的分析与校正.pdf", "retrieval_matched_block_title": "7-1 离散系统的基本概念", "retrieval_matched_block_score": 65, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["第七章 线性离散系统的分析与校正", "7-1 离散系统的基本概念", "1. 采样控制系统", "(2) 采样系统的典型结构图", "7-4 离散系统的数学模型", "5. 离散系统的稳态误差"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
