      <data key="d28">{"is_focus": true, "enabled": true, "subtopic_count_configured": 5, "chapter_page_range": [9, 32], "retrieval_keywords": ["自动控制", "一般概念", "反馈控制系统"], "syllabus_rule_source": "course_graph_config", "configured_prerequisites": [], "node_role": "chapter_anchor", "legacy_level": 1, "legacy_part_of": "", "resolved_prerequisite_nodes": [], "resolved_related_nodes": ["KM002", "KM003", "KM004", "KM005", "KM006"], "resolved_weak_related_nodes": ["KM035"], "resolved_dependent_nodes": ["KM007"], "resolved_prerequisite_names": [], "resolved_related_names": ["自动控制的基本原理与方式", "自动控制系统示例", "自动控制系统的分类", "对自动控制系统的基本要求", "自动控制系统的分析与设计工具"], "resolved_weak_related_names": ["线性离散系统的分析与校正"], "resolved_dependent_names": ["控制系统的数学模型"], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM002", "reason": "推荐先学习本章的第一个核心子知识点"}], "mineru_doc_name": "chapter_01_p009-032_自动控制的一般概念.pdf", "anchor_page": 9, "page_refs_refined": [9, 10, 11, 12, 13], "page_ref_status": "ok", "page_ref_count": 24, "page_refined_count": 5, "matched_block_title": "4. 反馈控制系统的组成", "matched_block_score": 18, "content_evidence_block_count": 6, "content_evidence_block_titles": ["1. 自动控制技术及其应用", "3. 反馈控制原理", "4. 反馈控制系统的组成", "5. 自动控制系统基本控制方式", "1-3 自动控制系统的分类", "1-5 自动控制系统的分析与设计工具"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 17, "retrieval_formula_line_count": 0, "retrieval_figure_line_count": 6, "retrieval_source_pdf": "chapter_01_p009-032_自动控制的一般概念.pdf", "retrieval_matched_block_title": "4. 反馈控制系统的组成", "retrieval_matched_block_score": 18, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["1. 自动控制技术及其应用", "2. 自动控制科学", "3. 反馈控制原理", "4. 反馈控制系统的组成", "5. 自动控制系统基本控制方式", "1-3 自动控制系统的分类"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
