      <data key="d28">{"chapter_anchor_node_id": "KM038", "chapter_anchor_name": "线性系统的状态空间分析与综合", "is_focus_chapter": false, "chapter_page_range": [393, 454], "retrieval_keywords": ["状态空间", "状态变量"], "syllabus_rule_source": "chapter_inherited", "configured_prerequisites": [], "node_role": "topic", "order_in_chapter": 2, "legacy_level": 2, "legacy_part_of": "KM038", "resolved_prerequisite_nodes": [], "resolved_related_nodes": ["KM038", "KM039"], "resolved_weak_related_nodes": [], "resolved_dependent_nodes": [], "resolved_prerequisite_names": [], "resolved_related_names": ["线性系统的状态空间分析与综合", "状态空间表达式"], "resolved_weak_related_names": [], "resolved_dependent_names": [], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM041", "reason": "本章子知识点已学习完毕，可进入下一章概览节点"}], "mineru_doc_name": "chapter_08_p393-454_线性系统的状态空间分析与综合.pdf", "anchor_page": 444, "page_refs_refined": [443, 444, 445, 446, 447], "page_ref_status": "ok", "page_ref_count": 62, "page_refined_count": 5, "matched_block_title": "1. 相平面的基本概念", "matched_block_score": 4, "content_evidence_block_count": 6, "content_evidence_block_titles": ["8-1 非线性控制系统概述", "1. 研究非线性控制理论的意义", "8-3 相 平 面 法", "1. 相平面的基本概念", "2. 相轨迹绘制的等倾线法", "5. 非线性系统的相平面分析"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 24, "retrieval_formula_line_count": 32, "retrieval_figure_line_count": 12, "retrieval_source_pdf": "chapter_08_p393-454_线性系统的状态空间分析与综合.pdf", "retrieval_matched_block_title": "1. 相平面的基本概念", "retrieval_matched_block_score": 4, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["8-1 非线性控制系统概述", "1. 研究非线性控制理论的意义", "2. 非线性系统的特征", "8-3 相 平 面 法", "1. 相平面的基本概念", "2. 相轨迹绘制的等倾线法"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
