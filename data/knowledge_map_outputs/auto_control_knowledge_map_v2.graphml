      <data key="d28">{"chapter_anchor_node_id": "KM012", "chapter_anchor_name": "线性系统的时域分析法", "is_focus_chapter": true, "chapter_page_range": [82, 159], "retrieval_keywords": ["时域分析", "时间响应", "系统响应"], "syllabus_rule_source": "chapter_inherited", "configured_prerequisites": ["系统时间响应的性能指标"], "node_role": "topic", "order_in_chapter": 2, "legacy_level": 2, "legacy_part_of": "KM012", "resolved_prerequisite_nodes": ["KM013"], "resolved_related_nodes": ["KM012", "KM013", "KM015"], "resolved_weak_related_nodes": [], "resolved_dependent_nodes": ["KM015"], "resolved_prerequisite_names": ["系统时间响应的性能指标"], "resolved_related_names": ["线性系统的时域分析法", "系统时间响应的性能指标", "二阶系统的时域分析"], "resolved_weak_related_names": [], "resolved_dependent_names": ["二阶系统的时域分析"], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM015", "reason": "这是当前知识点在本章内部的后续学习内容"}], "mineru_doc_name": "chapter_03_p082-159_线性系统的时域分析法.pdf", "anchor_page": 136, "page_refs_refined": [135, 136, 137, 138, 139], "page_ref_status": "ok", "page_ref_count": 78, "page_refined_count": 5, "matched_block_title": "3-2 一阶系统的时域分析", "matched_block_score": 63, "content_evidence_block_count": 6, "content_evidence_block_titles": ["第三章 线性系统的时域分析法", "(2) 稳态性能", "3-2 一阶系统的时域分析", "1. 一阶系统的数学模型", "3-3 二阶系统的时域分析", "3-4 高阶系统的时域分析"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 24, "retrieval_formula_line_count": 4, "retrieval_figure_line_count": 3, "retrieval_source_pdf": "chapter_03_p082-159_线性系统的时域分析法.pdf", "retrieval_matched_block_title": "3-2 一阶系统的时域分析", "retrieval_matched_block_score": 63, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["第三章 线性系统的时域分析法", "(2) 稳态性能", "3-2 一阶系统的时域分析", "1. 一阶系统的数学模型", "2. 一阶系统的单位阶跃响应", "3-3 二阶系统的时域分析"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
