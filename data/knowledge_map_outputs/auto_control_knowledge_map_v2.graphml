      <data key="d28">{"is_focus": true, "enabled": true, "subtopic_count_configured": 4, "chapter_page_range": [263, 311], "retrieval_keywords": ["系统校正", "控制器设计"], "syllabus_rule_source": "course_graph_config", "configured_prerequisites": ["线性系统的根轨迹法", "线性系统的频域分析法"], "node_role": "chapter_anchor", "legacy_level": 1, "legacy_part_of": "", "resolved_prerequisite_nodes": ["KM020", "KM026", "KM038"], "resolved_related_nodes": ["KM031", "KM032", "KM033", "KM034"], "resolved_weak_related_nodes": ["KM042"], "resolved_dependent_nodes": [], "resolved_prerequisite_names": ["线性系统的根轨迹法", "线性系统的频域分析法", "线性系统的状态空间分析与综合"], "resolved_related_names": ["常用校正装置及其特性", "串联校正", "反馈校正", "复合校正"], "resolved_weak_related_names": ["动态系统的最优控制方法"], "resolved_dependent_names": [], "learning_path_status": "ok", "recommended_next_reasons": [{"target": "KM031", "reason": "推荐先学习本章的第一个核心子知识点"}], "mineru_doc_name": "chapter_06_p263-311_线性系统的校正方法.pdf", "anchor_page": 263, "page_refs_refined": [263, 264, 265, 266, 267], "page_ref_status": "ok", "page_ref_count": 49, "page_refined_count": 5, "matched_block_title": "第六章 线性系统的校正方法", "matched_block_score": 60, "content_evidence_block_count": 6, "content_evidence_block_titles": ["第六章 线性系统的校正方法", "6-1 系统的设计与校正问题", "6-4 串 联 校 正", "3. 串联滞后校正", "4. 串联滞后-超前校正", "2. 按扰动补偿的复合校正"], "retrieval_status": "ok", "retrieval_candidate_sentence_count": 13, "retrieval_formula_line_count": 20, "retrieval_figure_line_count": 4, "retrieval_source_pdf": "chapter_06_p263-311_线性系统的校正方法.pdf", "retrieval_matched_block_title": "第六章 线性系统的校正方法", "retrieval_matched_block_score": 60, "retrieval_evidence_block_count": 7, "retrieval_evidence_block_titles": ["第六章 线性系统的校正方法", "6-1 系统的设计与校正问题", "6-4 串 联 校 正", "3. 串联滞后校正", "4. 串联滞后-超前校正", "6-6 复 合 校 正"], "generation_status": "ok", "generation_debug": {"definition_hits": 3, "keypoint_hits": 4, "formula_hits": 4, "example_hits": 3}}</data>
