# OmniTutor Environment Template
# ------------------------------------------------------------
# Copy this file to .env and fill your own keys:
# cp .env.example .env
# ------------------------------------------------------------

# ============================================================
# 1) Chat Profile (recommended entry)
# ============================================================
# Choose one:
# gemini / qwen / deepseek / openai / minimax / glm / custom
CHAT_PROFILE=deepseek

# Fill only the key for the profile you use.
# Unused keys can stay empty.
GEMINI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
GLM_API_KEY=

# Whether web "Local Config" is allowed to write local .env
LOCAL_CONFIG_ENABLED=true

# ============================================================
# 2) Custom mode (only when CHAT_PROFILE=custom)
# ============================================================
# LLM_PROVIDER: google | openai
LLM_PROVIDER=openai
GOOGLE_API_KEY=
OPENAI_API_BASE=
MODEL_NAME=

# ============================================================
# 3) RAG / Embedding
# ============================================================
# EMBEDDING_PROVIDER: local | google | openai
EMBEDDING_PROVIDER=local

# local: sentence-transformers/all-MiniLM-L6-v2
# google: models/text-embedding-004
# openai: text-embedding-3-small
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Vector store backend: chroma (persistent, recommended) | inmemory
VECTOR_STORE_BACKEND=chroma
VECTOR_STORE_DIR=data/vector_store

# ============================================================
# 4) Agent behavior
# ============================================================
TUTOR_TEMPERATURE=0.7
TESTER_TEMPERATURE=0.4
EVALUATOR_TEMPERATURE=0.0
PASS_SCORE=80

# ============================================================
# 5) Runtime paths
# ============================================================
MEMORY_DB_PATH=data/tutor_memory.db
KNOWLEDGE_DIR=data/knowledge
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_TOP_K=3
DEFAULT_THREAD_ID=haizi_master_01

# ============================================================
# 6) Optional proxy
# ============================================================
# Use only if your network cannot access provider APIs/HuggingFace directly.
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897

# ============================================================
# 7) API key quick hints (for beginners)
# ============================================================
# Gemini: Google AI Studio
# Qwen: Alibaba Cloud DashScope/Bailian
# DeepSeek: DeepSeek Platform
# GLM: BigModel Open Platform
# OpenAI: OpenAI Platform
# MiniMax: MiniMax Open Platform

# Minimal examples:
# A) DeepSeek + local RAG
# CHAT_PROFILE=deepseek
# DEEPSEEK_API_KEY=your_key
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# VECTOR_STORE_BACKEND=chroma

# B) Gemini + local RAG
# CHAT_PROFILE=gemini
# GEMINI_API_KEY=your_key
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# VECTOR_STORE_BACKEND=chroma
