# OmniTutor Environment Template
# Single source of truth for local configuration
# ------------------------------------------------------------
# Copy this file to .env and fill your own keys:
# cp .env.example .env
# ------------------------------------------------------------

# ============================================================
# 1) Chat Profile (recommended entry)
# ============================================================
# Choose one:
# gemini / qwen / deepseek / openai / minimax / glm / custom
CHAT_PROFILE=deepseek

# Fill only the key for the profile you use.
# Unused keys can stay empty.
GEMINI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MINIMAX_API_KEY=
GLM_API_KEY=
DASHSCOPE_API_KEY=

# Whether web "Local Config" is allowed to write local .env
LOCAL_CONFIG_ENABLED=true

# ============================================================
# 2) Custom mode (only when CHAT_PROFILE=custom)
# ============================================================
# LLM_PROVIDER: google | openai
LLM_PROVIDER=openai
GOOGLE_API_KEY=
OPENAI_API_BASE=
MODEL_NAME=

# ============================================================
# 3) RAG / Embedding
# Daily ops: usually only change PDF_PARSE_BACKEND
# ============================================================
# EMBEDDING_PROVIDER: local | google | openai | dashscope
EMBEDDING_PROVIDER=local

# local: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# google: models/text-embedding-004
# openai: text-embedding-3-small
# dashscope: text-embedding-v2
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# MinerU API token
# Only required when PDF_PARSE_BACKEND=mineru,
# or when you want auto mode to try MinerU before local fallback.
MINERU_API_TOKEN=

# PDF parsing backend:
# auto   = try MinerU first, then fall back to local PyMuPDF
# mineru = use MinerU only
# local  = use local PyMuPDF only
PDF_PARSE_BACKEND=auto

# Retrieval rewrite:
# false = keep current raw hybrid retrieval only
# true  = enable smart-gated LLM query rewrite on top of hybrid retrieval
RETRIEVAL_REWRITE_ENABLED=false
RETRIEVAL_REWRITE_MODE=smart
RETRIEVAL_REWRITE_DEBUG=false

# External evidence fallback:
# false = do not use web search when local evidence is weak
# true  = use Tavily as a supplemental evidence source
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Vector store backend: chroma (persistent, recommended) | inmemory
VECTOR_STORE_BACKEND=chroma

# Actual persisted vector directory
# Recommended default: data/chroma_db
# Legacy alias CHROMA_DIR is still recognized, but VECTOR_STORE_DIR is the primary key now.
VECTOR_STORE_DIR=data/chroma_db

# ============================================================
# 4) Agent behavior
# ============================================================
TUTOR_TEMPERATURE=0.7
TESTER_TEMPERATURE=0.4
EVALUATOR_TEMPERATURE=0.0
PASS_SCORE=80

# ============================================================
# 5) Runtime paths
# ============================================================
MEMORY_DB_PATH=data/tutor_memory.db
KNOWLEDGE_DIR=data/knowledge
COURSE_PRIMARY_ENABLED=true
COURSE_PRIMARY_DIR=a2-control-theory/source-notes
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_TOP_K=3
DEFAULT_THREAD_ID=haizi_master_01

# ============================================================
# 6) Optional proxy
# Daily ops: usually only change PROXY_PORT / PDF_PARSE_BACKEND / MINERU_PROXY_MODE
# ============================================================
# Recommended normal mode (uncomment only when you need a proxy):
# PROXY_HOST=127.0.0.1
# PROXY_PORT=7897
# PROXY_SCHEME=http
# NO_PROXY=127.0.0.1,localhost

# If your local proxy port is 7892 instead of 7897, only change:
# PROXY_PORT=7892

# You can still directly set HTTP_PROXY / HTTPS_PROXY if needed.
# HTTP_PROXY=
# HTTPS_PROXY=

# MinerU policy:
# inherit = follow global proxy
# direct  = MinerU uses direct connection, HuggingFace / model APIs still use global proxy
# MINERU_PROXY_MODE=inherit
# MINERU_CONNECT_TIMEOUT_SECONDS=5
# MINERU_PUBLIC_DNS_BYPASS_ENABLED=true
# MINERU_PUBLIC_DNS_SERVER=223.5.5.5
# MINERU_PUBLIC_DNS_PORT=53
# MINERU_PUBLIC_DNS_HOSTS=cdn-mineru.openxlab.org.cn

# Optional dedicated MinerU proxy overrides
# MINERU_HTTP_PROXY=
# MINERU_HTTPS_PROXY=

# ============================================================
# 7) API key quick hints (for beginners)
# ============================================================
# Gemini: Google AI Studio
# Qwen: Alibaba Cloud DashScope/Bailian
# DeepSeek: DeepSeek Platform
# GLM: BigModel Open Platform
# OpenAI: OpenAI Platform
# MiniMax: MiniMax Open Platform
# DashScope: Alibaba Cloud DashScope/Bailian

# Minimal examples:
# A) DeepSeek + local RAG
# CHAT_PROFILE=deepseek
# DEEPSEEK_API_KEY=your_key
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# VECTOR_STORE_BACKEND=chroma

# B) Gemini + local RAG
# CHAT_PROFILE=gemini
# GEMINI_API_KEY=your_key
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# VECTOR_STORE_BACKEND=chroma

# C) Any chat model + DashScope embedding + auto PDF parsing
# CHAT_PROFILE=deepseek
# DEEPSEEK_API_KEY=your_key
# EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_API_KEY=your_key
# EMBEDDING_MODEL_NAME=text-embedding-v2
# PDF_PARSE_BACKEND=auto
# MINERU_API_TOKEN=your_mineru_token
