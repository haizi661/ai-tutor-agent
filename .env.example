# ==========================================
# Chat Profile Configuration
# ==========================================
# 推荐直接使用 CHAT_PROFILE，让前端切换已定义档案:
# gemini / qwen / deepseek / openai / minimax / glm / custom
CHAT_PROFILE=gemini

# Gemini profile（可复用 Google AI Studio key）
GEMINI_API_KEY=your_gemini_api_key_here

# Qwen / DashScope profile
QWEN_API_KEY=your_qwen_api_key_here

# DeepSeek profile
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI profile
OPENAI_API_KEY=your_openai_api_key_here

# MiniMax profile
MINIMAX_API_KEY=your_minimax_api_key_here

# GLM / BigModel profile
GLM_API_KEY=your_glm_api_key_here

# 是否允许网页“本地配置”页写入本机 .env
LOCAL_CONFIG_ENABLED=true

# ==========================================
# Custom Chat Configuration (Optional)
# ==========================================
# 只有在 CHAT_PROFILE=custom 时才需要手动指定这些字段
# 这是“对话模型”的 provider。
# 可选: google / openai
LLM_PROVIDER=google

# Native Google provider (optional)
GOOGLE_API_KEY=your_google_api_key_here

# Manual OpenAI-compatible fallback (optional)
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY 仅用于 OpenAI 档案或 Custom 手动模式。
# 如果你使用 Gemini 档案，请优先填写 GEMINI_API_KEY，而不是把 Google key 放到 OPENAI_API_KEY。

# ==========================================
# Network / Proxy (Optional)
# ==========================================
# 代理不是总是必须；只有在你的网络无法直连模型 API 或 HuggingFace 时才需要。
# 推荐直接填写本机 HTTP 代理地址，例如：
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# 如果你第一次启动 local embedding 时卡住或下载失败，优先检查这里。

# ==========================================
# Chat Model Settings
# ==========================================
# 只有在 CHAT_PROFILE=custom 时才需要手动指定 MODEL_NAME
MODEL_NAME=gemini-2.5-pro

# ==========================================
# Embedding / RAG Settings
# ==========================================
# 这是“检索向量模型”的 provider，和 LLM_PROVIDER 独立。
# 小团队默认推荐 local，最稳。
EMBEDDING_PROVIDER=local

# local 例子: sentence-transformers/all-MiniLM-L6-v2
# google 例子: models/text-embedding-004
# openai 例子: text-embedding-3-small
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ==========================================
# Agent Parameters
# ==========================================
TUTOR_TEMPERATURE=0.7
TESTER_TEMPERATURE=0.4
EVALUATOR_TEMPERATURE=0.0
PASS_SCORE=80

# ==========================================
# System Paths
# ==========================================
MEMORY_DB_PATH=data/tutor_memory.db
KNOWLEDGE_DIR=data/knowledge
KNOWLEDGE_CHUNK_SIZE=1000
KNOWLEDGE_CHUNK_OVERLAP=150
KNOWLEDGE_TOP_K=3
DEFAULT_THREAD_ID=haizi_master_01

# ==========================================
# Web Runtime Notes
# ==========================================
# 网页里的“本地配置”页，本质上也是写服务端本机 `.env`。
# 适合个人本地使用，不适合共享部署场景。
# 推荐组合:
# 1) Gemini + Local RAG
#    CHAT_PROFILE=gemini
#    GEMINI_API_KEY=...
#    EMBEDDING_PROVIDER=local
#    EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
#
# 2) Qwen + Local RAG
#    CHAT_PROFILE=qwen
#    QWEN_API_KEY=...
#    EMBEDDING_PROVIDER=local
#    EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# 
# 3) DeepSeek + Local RAG
#    CHAT_PROFILE=deepseek
#    DEEPSEEK_API_KEY=...
#    EMBEDDING_PROVIDER=local
#    EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
#
# 4) OpenAI + Local RAG
#    CHAT_PROFILE=openai
#    OPENAI_API_KEY=...
#    EMBEDDING_PROVIDER=local
#    EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
#
# 5) MiniMax + Local RAG
#    CHAT_PROFILE=minimax
#    MINIMAX_API_KEY=...
#    EMBEDDING_PROVIDER=local
#    EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
#
# 6) GLM + Local RAG
#    CHAT_PROFILE=glm
#    GLM_API_KEY=...
#    EMBEDDING_PROVIDER=local
#    EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
