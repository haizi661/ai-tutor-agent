# ==========================================
# LLM Provider Configuration (Required)
# ==========================================
# Choose either "google" or "openai"
LLM_PROVIDER=google

# Option A: Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Option B: OpenAI Compatible (Qwen, DeepSeek, OpenAI, etc.)
OPENAI_API_KEY=your_openai_or_qwen_api_key_here
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ==========================================
# Network / Proxy (Optional)
# ==========================================
# If you are in a restricted network, set your SOCKS or HTTP proxy here:
# HTTP_PROXY=socks5://127.0.0.1:7890
# HTTPS_PROXY=socks5://127.0.0.1:7890

# ==========================================
# Model Settings
# ==========================================
MODEL_NAME=gemini-2.5-pro
# EMBEDDING_MODEL_NAME=models/text-embedding-004

# ==========================================
# Agent Parameters
# ==========================================
TUTOR_TEMPERATURE=0.7
TESTER_TEMPERATURE=0.4
EVALUATOR_TEMPERATURE=0.0
PASS_SCORE=80

# ==========================================
# System Paths
# ==========================================
MEMORY_DB_PATH=data/tutor_memory.db
KNOWLEDGE_DIR=data/knowledge
DEFAULT_THREAD_ID=haizi_master_01
