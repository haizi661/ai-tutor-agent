<node id="K086">
  <data key="d1">系统的闭环稳定性</data>
  <data key="d2">分段章节 3</data>
  <data key="d3">173,174,175,176,177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258</data>
  <data key="d4">0.038</data>
  <data key="d5">5-3 频率域稳定判据 控制系统的闭环稳定性是系统分析和设计所需解决的首要问题，奈奎斯特稳定判据 (简称奈氏判据)和对数频率稳定判据是常用的两种频域稳定判据。频域稳定判据的特点是 根据开环系统频率特性曲线判定闭环系统的稳定性。频域判据使用方便，易于推广。</data>
  <data key="d6">0.038</data>
  <data key="d7">0.0</data>
  <data key="d8">base=0.038; not_mentioned_in_outline</data>
  <data key="d9">0.0</data>
  <data key="d10"></data>
</node>
<node id="K087">
  <data key="d1">例如导弹控制系统</data>
